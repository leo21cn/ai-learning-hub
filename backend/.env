# ===== Learning Hub Backend Environment (LOCAL · gitignored) =====
# 复制自 .env.example;此处填入真实凭据,绝不入仓。

# 数据库
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=lh
DATABASE_PASSWORD=lh
DATABASE_NAME=learning_hub
DATABASE_URL=postgresql+psycopg2://lh:lh@postgres:5432/learning_hub

# 管理员
ADMIN_TOKEN=shleeyuan

# JWT
JWT_SECRET=please-change-me-in-production-32chars-min-length-xxxx
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=8

# CORS / 跨域(开发允许所有,生产收紧)
CORS_ALLOW_ORIGINS=*

# 时区
TIMEZONE=Asia/Shanghai

# 存储
STORAGE_PATH=/app/storage/documents

# ===== PPT 转图片服务（需与 Docker 镜像安装的 LibreOffice + poppler 一致）=====
LIBREOFFICE_PATH=/usr/bin/libreoffice
POPPLER_PATH=/usr/bin/pdftoppm
PPT_CONVERT_TIMEOUT=60

# 限流 Redis(可选;留空使用内存)
STORAGE_REDIS_URL=

# ===== LLM(阿里云百炼 qwen-plus 用于 NL2SQL)=====
DASHSCOPE_API_KEY=REMOVED-DASHSCOPE-KEY
LLM_SEARCH_MODEL=qwen-plus
LLM_SQL_TIMEOUT_SECONDS=8
LLM_SQL_MAX_ROWS=20

# 日志
LOG_LEVEL=INFO

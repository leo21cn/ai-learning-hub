# ===== Learning Hub Backend Environment =====
# 复制本文件为 .env(本地)或注入到 docker-compose 环境变量(容器)

# 数据库
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=lh
DATABASE_PASSWORD=lh
DATABASE_NAME=learning_hub
DATABASE_URL=postgresql+psycopg2://lh:lh@postgres:5432/learning_hub

# 管理员
ADMIN_TOKEN=shleeyuan

# JWT
JWT_SECRET=please-change-me-in-production-32chars-min-length-xxxx
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=8

# CORS / 跨域(开发允许所有,生产收紧)
CORS_ALLOW_ORIGINS=*

# 时区
TIMEZONE=Asia/Shanghai

# 存储
STORAGE_PATH=/app/storage/documents

# ===== PPT 转图片服务（需与 Docker 镜像安装的 LibreOffice + poppler 一致）=====
# LibreOffice：PPT/PPTX -> 中间 PDF
# 可执行文件绝对路径。Docker 镜像默认 /usr/bin/libreoffice；Windows 本地开发
# 可指向 "C:\\Program Files\\LibreOffice\\program\\soffice.exe"
LIBREOFFICE_PATH=/usr/bin/libreoffice
# poppler：PDF -> 多张 PNG
# Docker 镜像默认 /usr/bin/pdftoppm；Windows 本地开发可指向 poppler bin 目录
POPPLER_PATH=/usr/bin/pdftoppm
# 单个 PPT/PPTX 转换超时（秒）；超时后仅记日志，不阻塞上传
PPT_CONVERT_TIMEOUT=60

# 限流 Redis(可选;留空使用内存)
STORAGE_REDIS_URL=

# LLM(阿里云百炼 qwen-plus 用于 NL2SQL;留空表示禁用,前台搜索降级到关键词)
DASHSCOPE_API_KEY=
LLM_SEARCH_MODEL=qwen-plus
LLM_SQL_TIMEOUT_SECONDS=8
LLM_SQL_MAX_ROWS=20

# 日志
LOG_LEVEL=INFO

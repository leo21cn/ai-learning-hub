# learning-hub smartmoves vhost (HTTPS-only phase)
# used by nginx-vhost-apply.sh -phase 2 (after cert is mounted in container)
# Insert before the last '}' of http{} block in /root/nginx-smartmoves/nginx.conf.

# --- learning-hub.smartmoves.com.cn HTTPS (upstream + 443 server block) ---
upstream learning_hub_frontend { server learning-hub_frontend:80; }

server {
    listen 443 ssl;
    http2 on;
    server_name learning-hub.smartmoves.com.cn;

    ssl_certificate     /etc/nginx/certs/learning-hub.smartmoves.com.cn.crt;
    ssl_certificate_key /etc/nginx/certs/learning-hub.smartmoves.com.cn.key;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";

    charset utf-8;

    # 大文件上传超时：5–10Mbps 上传 500MB 需 400–800s。
    # 默认 proxy_send_timeout = 60s 会切断上传,必须拉高。client_body_timeout 同理。
    client_max_body_size 500m;
    client_body_timeout 600s;

    location / {
        proxy_pass http://learning_hub_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # 不要把请求体缓存到磁盘,边收边转发,适合上传大文件。
        proxy_request_buffering off;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_connect_timeout 60s;
    }
}

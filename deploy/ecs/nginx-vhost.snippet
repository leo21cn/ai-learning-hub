# ==========================================================================
# learning-hub.smartmoves.com.cn vhost
# 由 nginx-vhost-apply.sh 自动追加到 /root/nginx-smartmoves/nginx.conf 末尾
# 的最后一个 `}` 之前(等价于 http{} 内嵌)。
#
# 风格与 nginx-gateway 内 pulan.smartmoves.com.cn vhost 一致(参考 2026-07-08 实地调查):
#   - 80 -> 443 redirect,带 /.well-known/acme-challenge 留给续期
#   - 443 ssl http2
#   - 通用安全头(X-Content-Type-Options / X-Frame-Options / X-XSS-Protection)
#   - 无 HSTS(与其他 vhost 保持一致)
#
# 上游 `learning-hub_frontend` 是 learning-hub stack 内 frontend 服务(端口 80),
# swarm DNS 在 nginx-gateway 容器所在的 `docker_default` 网络上解析该名。
# ==========================================================================

# ── learning-hub.smartmoves.com.cn HTTP → HTTPS redirect ─────────────────
server {
    listen 80;
    server_name learning-hub.smartmoves.com.cn;
    location /.well-known/acme-challenge/ { root /usr/share/nginx/html; }
    location / { return 301 https://$host$request_uri; }
}

# ── learning-hub.smartmoves.com.cn HTTPS ─────────────────────────────────
upstream learning_hub_frontend { server learning-hub_frontend:80; }

server {
    listen 443 ssl;
    http2 on;
    server_name learning-hub.smartmoves.com.cn;

    ssl_certificate     /etc/nginx/certs/learning-hub.smartmoves.com.cn.crt;
    ssl_certificate_key /etc/nginx/certs/learning-hub.smartmoves.com.cn.key;

    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";

    charset utf-8;

    client_max_body_size 200m;
    client_body_timeout 120s;

    location / {
        proxy_pass http://learning_hub_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_connect_timeout 30s;
    }
}

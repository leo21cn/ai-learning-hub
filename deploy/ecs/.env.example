# ===== Learning Hub ECS 发布 — 环境变量模板 =====
# 复制本文件为 .env 并填入实际值(.env 不入仓)。本机 publish.ps1 与 ECS 端 deploy/*.sh 都依赖它。

# ===== SSH 远程认证 =====
ECS_SSH_USER=root
ECS_HOST=121.199.53.233
ECS_SSH_KEY_PATH=~/.ssh/id_ed25519
ECS_REMOTE_DIR=/root/learning-hub

# ===== 镜像 Tag =====
# 每次发布会按日期自动调整,也可手动覆盖(例如发布 hotfix 时用 commit hash)。
IMAGE_TAG=2026-07-08

# ===== Stack 网络(ECS 已存在的 overlay 网络,publish.ps1 不重建) =====
# postgres stack 服务所在的网络——已确认 agent-mcp-container 与 nginx-gateway / postgres 都在这网络上。
POSTGRES_NETWORK_NAME=agent-mcp-container_agent-mcp-net
# postgres stack 服务名——swarm DNS 通过该名访问跨 stack 服务。
POSTGRES_SERVICE_NAME=postgres_postgres
# nginx-gateway 容器所在的网络——learning-hub frontend 接入后才能被 nginx-gateway 解析到。
NGINX_NETWORK_NAME=docker_default

# ===== 数据库连接(复用 postgres stack 现有 user)=====
DATABASE_PORT=5432
DATABASE_USER=agent_mcp
DATABASE_PASSWORD=your-db-password-here
DATABASE_NAME=learning_hub

# ===== 后端运行参数 =====
# 与 backend/app/core/config.py 中字段名一致(全大写 + env_file 自动注入)。
ADMIN_TOKEN=change-me-admin-token
# 32+ 字符串,生产环境务必替换。openssl rand -hex 32
JWT_SECRET=please-replace-me-with-openssl-rand-hex-32-bytes-xxxx
# 阿里云百炼 qwen-plus API key。留空 → LLM 禁用,前台搜索全部降级到关键词 ILIKE。
DASHSCOPE_API_KEY=
LLM_SEARCH_MODEL=qwen-plus
# 公网允许的 CORS Origin(逗号分隔)。生产建议收紧为 LH_DOMAIN。
CORS_ALLOW_ORIGINS=*

# ===== 域名 / 证书 =====
LH_DOMAIN=learning-hub.smartmoves.com.cn
